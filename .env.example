# Copy to .env and fill in. Never commit .env. (docs/02 section 5)

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=

# Long random strings, different from each other (e.g. `openssl rand -hex 48`)
JWT_SECRET=
JWT_REFRESH_SECRET=

# 32-byte key (64 hex characters) that encrypts 2FA secrets in the database.
# Generate with `openssl rand -hex 32`. If you lose or change it, every user
# must set up 2FA again.
TOTP_ENC_KEY=

# Cookie domain for staff auth cookies. Leave blank in development; in
# production set it to your site domain (e.g. example.com).
COOKIE_DOMAIN=

# First admin account. Used ONLY when the users collection is empty.
# Password: 12+ characters. After the first sign-in (you will be asked to set
# up 2FA), remove SEED_ADMIN_PASSWORD from this file.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Starting SAR->PKR rate used by `npm run seed` when no rate exists yet.
# A decimal string. Change it later in the admin portal, not here.
SEED_FX_RATE=75.00
# CORS allow-list: comma-separated browser origins allowed to call the API from
# another origin. Leave blank: the site and the API share one origin (Vite proxy
# in development, the Pages Function in production; docs/DEPLOY.md).
WEB_ORIGIN=

# Production only: reverse proxies in front of the API, so rate limits and the
# audit log see the visitor's real IP. Confirm the value on staging
# (docs/DEPLOY.md section 9, step 4).
TRUST_PROXY_HOPS=1

# Production: a long random string (openssl rand -hex 32), also set in the
# Cloudflare Pages project. The API then refuses requests that skip the site's
# proxy. Leave blank in development.
ORIGIN_PROXY_SECRET=

# Cloudflare R2 (S3-compatible) for original rate-sheet files.
# Leave all four blank in development: files then go to the .local-storage
# folder. Required in production.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Email (Resend). Leave blank in development: emails are only logged (kind and
# subject, never addresses). Both are required in production.
RESEND_API_KEY=
# e.g. "Marafiq Us Safar <quotes@your-domain.com>" (the domain must be verified in Resend)
MAIL_FROM=
# Optional staff inbox told about new inquiries, accepted quotes and questions.
STAFF_NOTIFY_EMAIL=

# Rate-sheet reading (Anthropic API). Set a monthly spending cap on the account.
# Leave the key blank to enter sheets by hand only.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5-5

# Malware scanning for document intelligence: a ClamAV daemon (clamd) reachable
# over TCP (docs/DEPLOY.md section 6.3). Blank host = no scanner: uploaded
# documents are kept but never parsed (the pipeline needs a clean scan first).
CLAMAV_HOST=
CLAMAV_PORT=3310

# Phase 4A document-intelligence resource limits. Defaults are safe initial
# values; increase only after measuring representative documents and memory use.
DOCUMENT_MAX_FILE_BYTES=20971520
DOCUMENT_MAX_PDF_PAGES=100
DOCUMENT_MAX_PDF_PAGE_TEXT_BYTES=1048576
DOCUMENT_MAX_IMAGE_SIDE=10000
DOCUMENT_MAX_IMAGE_PIXELS=20000000
DOCUMENT_MAX_XLSX_SHEETS=20
DOCUMENT_MAX_XLSX_CELLS=200000
DOCUMENT_MAX_XLSX_ZIP_ENTRIES=1000
DOCUMENT_MAX_XLSX_UNCOMPRESSED_BYTES=67108864
DOCUMENT_MAX_XLSX_ENTRY_BYTES=16777216
DOCUMENT_MAX_XLSX_COMPRESSION_RATIO=250
DOCUMENT_MAX_CSV_RECORDS=100000
DOCUMENT_MAX_CSV_COLUMNS=200
DOCUMENT_MAX_CSV_CELLS=1000000
DOCUMENT_MAX_EVIDENCE_RECORDS=10000
DOCUMENT_MAX_EVIDENCE_BYTES=33554432
DOCUMENT_EVIDENCE_CHUNK_BYTES=49152
DOCUMENT_MAX_CONCURRENT_UPLOADS=2

# Error reporting (Sentry). Blank = off. Events are scrubbed of request data
# and messages before they are sent (apps/api/src/lib/monitoring.ts).
SENTRY_DSN=
SENTRY_RELEASE=

# Public base URL used in quote links. Required in production, where it must be the
# real https address (e.g. https://your-domain.com). Blank in development = the
# Vite dev site, http://localhost:5175.
PUBLIC_SITE_URL=

# Browser flow test only (npm run e2e:flow). The database is WIPED on each run,
# so it must be named exactly "marafiq_e2e", and the run must also have
# E2E_ALLOW_DB_RESET=true set in its environment. Never set that flag here or on
# a server. Not read by the API itself.
E2E_MONGODB_URI=mongodb://127.0.0.1:27017/marafiq_e2e

# Backups (npm run backup / npm run restore; docs/DEPLOY.md sections 10-11).
# Blank in development: backups go to the .local-backups folder. In production
# the backup job needs its own private bucket, never R2_BUCKET, and MongoDB
# Database Tools 100.3+ (mongodump, mongorestore).
BACKUP_BUCKET=
BACKUP_RETENTION_DAYS=30
BACKUP_KEEP_MIN=7
MONGODUMP_PATH=
MONGORESTORE_PATH=
