# Copy to .env and fill in. Never commit .env. (docs/02 section 5)

NODE_ENV=development
PORT=4002

# MongoDB Atlas connection string
MONGODB_URI=

# Long random strings, different from each other (e.g. `openssl rand -hex 48`)
JWT_SECRET=
JWT_REFRESH_SECRET=

# 32-byte key (64 hex characters) that encrypts 2FA secrets in the database.
# Generate with `openssl rand -hex 32`. If you lose or change it, every user
# must set up 2FA again.
TOTP_ENC_KEY=

# Cookie domain for staff auth cookies. Leave blank in development; in
# production set it to your site domain (e.g. example.com).
COOKIE_DOMAIN=

# First admin account. Used ONLY when the users collection is empty.
# Password: 12+ characters. After the first sign-in (you will be asked to set
# up 2FA), remove SEED_ADMIN_PASSWORD from this file.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Origin of the web app, used for the CORS allow-list
WEB_ORIGIN=http://localhost:5175

# Cloudflare R2 (S3-compatible) for original rate-sheet files
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=

# Rate-sheet extraction (Anthropic API). Set a monthly spending cap on the account.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5-5

# Error reporting
SENTRY_DSN=

# Public base URL used in quote links
PUBLIC_SITE_URL=http://localhost:5175
