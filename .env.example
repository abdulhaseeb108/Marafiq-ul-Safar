# Copy to .env and fill in. Never commit .env. (docs/02 section 5)

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=

# Long random strings, different from each other (e.g. `openssl rand -hex 48`)
JWT_SECRET=
JWT_REFRESH_SECRET=

# 32-byte key (64 hex characters) that encrypts 2FA secrets in the database.
# Generate with `openssl rand -hex 32`. If you lose or change it, every user
# must set up 2FA again.
TOTP_ENC_KEY=

# Cookie domain for staff auth cookies. Leave blank in development; in
# production set it to your site domain (e.g. example.com).
COOKIE_DOMAIN=

# First admin account. Used ONLY when the users collection is empty.
# Password: 12+ characters. After the first sign-in (you will be asked to set
# up 2FA), remove SEED_ADMIN_PASSWORD from this file.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Starting SAR->PKR rate used by `npm run seed` when no rate exists yet.
# A decimal string. Change it later in the admin portal, not here.
SEED_FX_RATE=75.00
# Origin of the web app, used for the CORS allow-list
WEB_ORIGIN=http://localhost:5173

# Cloudflare R2 (S3-compatible) for original rate-sheet files.
# Leave all four blank in development: files then go to the .local-storage
# folder. Required in production.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=

# Rate-sheet reading (Anthropic API). Set a monthly spending cap on the account.
# Leave the key blank to enter sheets by hand only.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5-5

# Phase 4A document-intelligence resource limits. Defaults are safe initial
# values; increase only after measuring representative documents and memory use.
DOCUMENT_MAX_FILE_BYTES=20971520
DOCUMENT_MAX_PDF_PAGES=100
DOCUMENT_MAX_PDF_PAGE_TEXT_BYTES=1048576
DOCUMENT_MAX_IMAGE_SIDE=10000
DOCUMENT_MAX_IMAGE_PIXELS=20000000
DOCUMENT_MAX_XLSX_SHEETS=20
DOCUMENT_MAX_XLSX_CELLS=200000
DOCUMENT_MAX_XLSX_ZIP_ENTRIES=1000
DOCUMENT_MAX_XLSX_UNCOMPRESSED_BYTES=67108864
DOCUMENT_MAX_XLSX_ENTRY_BYTES=16777216
DOCUMENT_MAX_XLSX_COMPRESSION_RATIO=250
DOCUMENT_MAX_CSV_RECORDS=100000
DOCUMENT_MAX_CSV_COLUMNS=200
DOCUMENT_MAX_CSV_CELLS=1000000
DOCUMENT_MAX_EVIDENCE_RECORDS=10000
DOCUMENT_MAX_EVIDENCE_BYTES=33554432
DOCUMENT_EVIDENCE_CHUNK_BYTES=49152
DOCUMENT_MAX_CONCURRENT_UPLOADS=2

# Error reporting
SENTRY_DSN=

# Public base URL used in quote links
PUBLIC_SITE_URL=http://localhost:5173
