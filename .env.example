# Copy to .env and fill in. Never commit .env. (docs/02 section 5)

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=

# Long random strings, different from each other (e.g. `openssl rand -hex 48`)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cookie domain for staff auth cookies (localhost in dev)
COOKIE_DOMAIN=localhost
# Origin of the web app, used for the CORS allow-list
WEB_ORIGIN=http://localhost:5173

# Cloudflare R2 (S3-compatible) for original rate-sheet files
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=

# Rate-sheet extraction (Anthropic API). Set a monthly spending cap on the account.
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5-5

# Error reporting
SENTRY_DSN=

# Public base URL used in quote links
PUBLIC_SITE_URL=http://localhost:5173
